# Client: public Supabase project configuration (RLS protects user data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server authentication configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Existing Coach gateway: server-only
LOVABLE_API_KEY=

# Optional: migration CLI only, never bundled into the app
DATABASE_URL=

# Optional server-only model override for opt-in food-photo analysis
FOOD_VISION_MODEL=

# Preferred server-only provider for Maya and opted-in food photos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
